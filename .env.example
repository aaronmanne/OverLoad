NGROK_AUTHTOKEN=your_ngrok_auth_token_here
PORT=5000
OVERLOAD_STRATEGY=adversarial
OVERLOAD_NUM_EXAMPLES=1
OVERLOAD_SIZE_KB=512
OVERLOAD_CACHE=1
OVERLOAD_LOG=/app/visits.log

# Ollama Integration (for interactive testing at /test)
# Default: http://host.docker.internal:11434 (connects to host machine from Docker)
# If running outside Docker, use: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
